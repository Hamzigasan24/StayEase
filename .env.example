# StayEase environment template (Step 14).
# Copy to .env and fill in REAL values. NEVER commit .env to Git.
# cp .env.example .env

APP_NAME=StayEase Hotel Reservation API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# PostgreSQL (SQLAlchemy). Replace USERNAME/PASSWORD/DATABASE.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/stayease_db

# MongoDB (PyMongo). No auth by default locally; add credentials for shared servers.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=stayease_db

# JWT. Generate a strong secret, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: comma-separated browser origins allowed to call the API.
# Development frontend examples; production MUST list the real frontend origin(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Testing only (pytest uses these; never production data).
TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/stayease_test_db
TEST_MONGO_DATABASE=stayease_test
